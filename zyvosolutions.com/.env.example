# ============================================================================
# Zyvo — environment configuration
# Copy to .env.local (dev) / .env.production (deploy) and fill in real values.
# NEVER put private email-provider keys in VITE_ variables — those are public.
# ============================================================================

# --- Supabase (publishable/anon key only — safe for the browser) ------------
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Site config -------------------------------------------------------------
# Production domain used for canonical URLs, Open Graph tags and sitemap.
# (Read at build time by frontend and used for canonical/OG metadata.)
VITE_SITE_URL=https://zyvo.example.com

# ============================================================================
# The following are SUPABASE EDGE FUNCTION SECRETS — server-side only.
# Set with:  supabase functions secrets set KEY=value   (serviceRoleKey auto-provided)
# These must never appear in any VITE_ variable.
# ============================================================================

# RESEND_API_KEY=            # https://resend.com — API key for email delivery
# RESEND_FROM_EMAIL=         # Verified sender, e.g. "Zyvo <hello@yourdomain.com>"
# NOTIFY_EMAIL=              # Business inbox that receives inquiry notifications
# ALLOWED_ORIGINS=           # Comma-separated origins allowed to call the function,
#                            # e.g. "https://zyvo.example.com,http://localhost:5173"
